# =============================================================================
# Jay Shree Ram Bike Point — Environment Variables Reference
# =============================================================================
# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings -> Environment Variables.
# =============================================================================

# ─── DATABASE (Neon Serverless PostgreSQL) ──────────────────────────────────
# Connection pool string for Prisma Client queries (port 5432 or pgbouncer)
DATABASE_URL="postgresql://user:password@ep-cool-pool-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection string for Prisma CLI migrations (bypasses pgbouncer)
DIRECT_URL="postgresql://user:password@ep-cool-pool-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ─── AUTHENTICATION (NextAuth v5 / Auth.js) ─────────────────────────────────
# Generated secret for JWT token encryption (Run: openssl rand -base64 32)
AUTH_SECRET="your-32-character-random-auth-secret-key-here"

# Canonical production app URL (e.g., https://jsrbikepoint.com)
AUTH_URL="https://jsrbikepoint.com"

# Initial Dealership Admin Credentials for Seeding
ADMIN_EMAIL="admin@jsrbikepoint.com"
ADMIN_PASSWORD="ReplaceWithStrongProductionPassword123!"
ADMIN_NAME="Jay Shree Ram Admin"

# ─── MEDIA STORAGE (Cloudinary Production Account) ──────────────────────────
# Public Cloud Name (Client-side exposed)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"

# Private API Credentials (Server-side only)
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"

# ─── PUBLIC APP URL ─────────────────────────────────────────────────────────
# Production website domain (used for canonical URLs, OpenGraph, and Sitemaps)
NEXT_PUBLIC_APP_URL="https://jsrbikepoint.com"
